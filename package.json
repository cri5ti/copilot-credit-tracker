{
  "name": "copilot-tracker-ent",
  "displayName": "Copilot Tracker (Enterprise)",
  "description": "Status bar tracker for GitHub Copilot AI credits on enterprise-managed accounts, paced against the month's workdays.",
  "icon": "logo.png",
  "version": "0.2.1",
  "publisher": "cri5ti",
  "repository": {
    "type": "git",
    "url": "https://github.com/cri5ti/copilot-credit-tracker.git"
  },
  "license": "MIT",
  "keywords": [
    "github copilot",
    "copilot",
    "ai credits",
    "usage",
    "enterprise",
    "status bar"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.github-authentication"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Copilot Tracker Ent",
      "properties": {
        "copilotTrackerEnt.monthlyLimit": {
          "type": "number",
          "default": 7000,
          "description": "Fallback monthly AI credit limit, used only when GitHub does not report one for your account."
        }
      }
    },
    "commands": [
      {
        "command": "copilot-tracker-ent.showPanel",
        "title": "Copilot Tracker Ent: Show Panel"
      },
      {
        "command": "copilot-tracker-ent.showLog",
        "title": "Copilot Tracker Ent: Show Log"
      },
      {
        "command": "copilot-tracker-ent.refresh",
        "title": "Copilot Tracker Ent: Refresh Now"
      },
      {
        "command": "copilot-tracker-ent.reauthenticate",
        "title": "Copilot Tracker Ent: Re-authenticate with GitHub"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
